{
  "name": "@jakeboone02/graphlite-node",
  "version": "0.0.1",
  "description": "Node.js bindings for GraphLite embedded graph database (ISO GQL)",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "graphlite-node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "vitest run",
    "universal": "napi universal",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">= 18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jakeboone02/graphlite-node.git"
  },
  "keywords": [
    "graphlite",
    "graph",
    "database",
    "gql",
    "iso-gql",
    "embedded",
    "napi",
    "native"
  ]
}
